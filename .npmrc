# Aucun script d'installation npm ne tourne (contrôlé par scripts/scripts-installation.sh).
# Un paquet qui en a vraiment besoin : décision du porteur, à lancer à la main.
ignore-scripts=true
# Attendre 7 jours avant d'accepter une version fraîchement publiée (npm 11.10 ou plus ;
# sans effet avant, et sans avertissement avec npm 10.9), comme le cooldown de Dependabot.
# npm ci suit le lockfile. La variable npm_config_ignore_scripts passerait avant ce fichier :
# scripts/scripts-installation.sh vérifie aussi la valeur vue par npm.
min-release-age=7
